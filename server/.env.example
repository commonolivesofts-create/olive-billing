# Server-only configuration template. Copy to an ignored .env locally.
# Empty values must be supplied securely and validated when implemented.
NODE_ENV=development
PORT=
APP_ORIGIN=
TRUST_PROXY=
# Existing local DB; provision a restricted application account, never root.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Use separate ignored environment files for test and migration identities.
SESSION_SECRET=
SESSION_COOKIE_NAME=
SESSION_IDLE_MINUTES=
SESSION_ABSOLUTE_HOURS=
APP_ENCRYPTION_KEY=
# Optional external configuration; no credentials in frontend or logs.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_ACCESS_TOKEN=
# Admin provisioning obtains password interactively; do not persist user passwords here.
ADMIN_EMAIL=
# Server operational configuration (to be bound and validated during implementation).
API_RATE_LIMIT_PER_MINUTE=
LOGIN_RATE_LIMIT_PER_WINDOW=
LOGIN_FAILED_LIMIT_PER_WINDOW=
LOGIN_WINDOW_MINUTES=
PASSWORD_CHANGE_RATE_LIMIT_PER_WINDOW=
SMTP_TEST_RATE_LIMIT_PER_WINDOW=
PDF_RATE_LIMIT_PER_MINUTE=
FINANCIAL_RATE_LIMIT_PER_MINUTE=
UPLOAD_MAX_BYTES=
PRIVATE_STORAGE_PATH=
LOG_LEVEL=info
TZ=Asia/Kolkata
# No JWT authentication in this approved design. No JWT secret required.
